DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web

POSTGRES_DB=reservation
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

CORS_ALLOWED_ORIGINS=http://localhost:3000

DEFAULT_COMMISSION_RATE=0.10
DEFAULT_CANCELLATION_WINDOW_HOURS=24
STRIKE_LIMIT=3
STRIKE_WINDOW_DAYS=90

# Email — dev uses console backend; switch to SMTP for staging/prod
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Reserva <noreply@reserva.local>

# PayMongo — leave blank to use dev/fake checkout sessions in local development.
# Get sandbox keys at https://dashboard.paymongo.com/developers
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=
