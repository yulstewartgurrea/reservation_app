DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
# Operating region for shop hours / slot generation. Storage stays UTC.
DJANGO_TIME_ZONE=Asia/Manila

POSTGRES_DB=reservation
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

CORS_ALLOWED_ORIGINS=http://localhost:3000

DEFAULT_COMMISSION_RATE=0.10
DEFAULT_CANCELLATION_WINDOW_HOURS=24
STRIKE_LIMIT=3
STRIKE_WINDOW_DAYS=90

# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------
# Dev default = console backend (emails print to `docker compose logs web`).
# To send real mail, pick ONE of the recipes below and replace this block.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=BookMe <noreply@bookme.local>
# FRONTEND_URL is used to build absolute links inside emails (verify/reset).
FRONTEND_URL=http://localhost:3000

# --- Recipe A: Gmail SMTP (quickest for dev/staging) -------------------------
# 1. Turn on 2-Step Verification: https://myaccount.google.com/security
# 2. Create an "App password" (16 chars, no spaces): https://myaccount.google.com/apppasswords
# 3. Uncomment + paste:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-gmail-address@gmail.com
# EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx   # 16-char app password
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=BookMe <your-gmail-address@gmail.com>
# Gmail caps free accounts at ~500 sends/day. Fine for personal/staging.

# --- Recipe B: AWS SES (production) ------------------------------------------
# 1. Verify a sender domain or address in SES (us-east-1 / ap-southeast-1).
# 2. Create SMTP credentials in the SES console (NOT your IAM access key).
# 3. Until you "request production access" you can only send to verified addresses.
# 4. Uncomment + paste (replace region):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=email-smtp.ap-southeast-1.amazonaws.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=AKIA...                   # SES SMTP username (not the IAM key)
# EMAIL_HOST_PASSWORD=...                   # SES SMTP password
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=BookMe <noreply@yourdomain.com>

# -----------------------------------------------------------------------------
# PayMongo  (payments — PHP only, GCash / GrabPay / Maya / cards)
# -----------------------------------------------------------------------------
# Leave all three BLANK to enable dev-fake mode: checkout returns a fake URL and
# you can simulate payment via POST /api/payments/reservations/<id>/dev-confirm/.
#
# To enable real payments:
# 1. Sign up at https://dashboard.paymongo.com (Philippines business required for live).
# 2. Settings -> Developers -> API Keys -> copy the **Test** keys.
# 3. Settings -> Developers -> Webhooks -> Add webhook:
#       URL:    https://<your-host>/api/payments/webhooks/paymongo/
#       Events: checkout_session.payment.paid, checkout_session.payment.failed,
#               payment.paid, payment.failed
#    Copy the signing secret into PAYMONGO_WEBHOOK_SECRET below.
# 4. For local dev, expose web on a public URL with `ngrok http 8000` and register
#    https://<random>.ngrok.app/api/payments/webhooks/paymongo/ as the webhook URL.
# 5. Restart `web` + `worker` so the new env is loaded.
# 6. When ready for production, swap sk_test_/pk_test_ for sk_live_/pk_live_ and
#    register a separate live-mode webhook with a fresh secret.
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=
